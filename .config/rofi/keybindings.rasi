@theme "/dev/null"
@import "~/.cache/wal/colors-rofi-custom.rasi"

* {
    background-color: transparent;
    text-color: @wal-fg;
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 800px;
    background-color: rgba(0, 0, 0, 88%);
    border: 2px;
    border-color: @wal-accent;
    border-radius: 16px;
    padding: 16px;
}

mainbox {
    children: [inputbar, message, listview];
    spacing: 12px;
}

inputbar {
    children: [prompt, entry];
    background-color: rgba(255, 255, 255, 6%);
    border-radius: 10px;
    padding: 12px 16px;
    spacing: 12px;
}

prompt {
    text-color: @wal-accent;
}

entry {
    text-color: @wal-fg;
    placeholder: "Type to search";
    placeholder-color: @wal-dim;
    vertical-align: 0.5;
}

message {
    padding: 0px 12px;
}

textbox {
    text-color: @wal-dim;
}

listview {
    lines: 18;
    fixed-height: true;
    scrollbar: true;
    spacing: 2px;
}

element {
    padding: 8px 14px;
    border-radius: 10px;
}

element normal.normal, element alternate.normal {
    text-color: @wal-dim;
}

element selected.normal {
    background-color: @wal-accent;
    text-color: @wal-bg;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}

scrollbar {
    width: 4px;
    handle-color: @wal-accent;
    border-radius: 2px;
}
